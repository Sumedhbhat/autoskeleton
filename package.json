{
  "name": "autoskeleton",
  "version": "0.1.0",
  "description": "Wrap any React component in <Skeleton loading> and get a pixel-accurate skeleton of it. No second skeleton component to maintain.",
  "license": "MIT",
  "author": "Sumedh Bhat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sumedhbhat/autoskeleton.git"
  },
  "homepage": "https://github.com/Sumedhbhat/autoskeleton#readme",
  "bugs": {
    "url": "https://github.com/Sumedhbhat/autoskeleton/issues"
  },
  "keywords": [
    "react",
    "skeleton",
    "skeleton-loader",
    "loading",
    "placeholder",
    "shimmer",
    "suspense"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skill",
    "README.md",
    "LICENSE",
    "VERSION"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup && node scripts/write-css.mjs",
    "dev": "vite --config demo/vite.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:ssr": "node tests/ssr.test.mjs",
    "check:package": "publint --strict && attw --pack . --profile node16 --exclude-entrypoints styles.css",
    "bench": "node scripts/bench.mjs",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "publint": "^0.3.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2"
  }
}
